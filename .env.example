# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=nem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nem_ecommerce
# Dev: Postgres published on 5433 (5432 is often taken locally)
DATABASE_URL=postgresql://nem:change-me@localhost:5433/nem_ecommerce?schema=public

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# S3-compatible object storage (MinIO in docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nem-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=http://localhost:9000/nem-uploads

# Seed admin (dev only)
SEED_ADMIN_EMAIL=admin@nem.local
SEED_ADMIN_PASSWORD=
